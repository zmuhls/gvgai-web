{
  "name": "gvgai-web-frontend",
  "version": "1.0.0",
  "description": "GVGAI arcade with Cloudflare CLEF decision control",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:clef": "node scripts/start-clef.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "test:cadavre": "node --test test/cadavre-*.test.js",
    "test:seeds": "node scripts/check-java-seeds.js",
    "wall:migrate": "node scripts/migrate-cadavre-wall.js",
    "java:prepare": "node scripts/prepare-java-runtime.js",
    "telemetry:check": "node scripts/check-supabase-telemetry.js",
    "telemetry:backfill": "node scripts/backfill-telemetry.js",
    "sync:cadavre-ui": "node scripts/sync-cadavre-ui.js",
    "eval:arcade": "node scripts/run-arcade-eval.js --dry-run --all",
    "eval:clef": "node scripts/run-clef-eval.js",
    "eval:clef:matrix": "node scripts/run-clef-matrix.js",
    "eval:arcade:execute": "node scripts/run-arcade-eval.js",
    "tournament:run": "node scripts/run-model-tournament.js",
    "tournament:scheduled": "node scripts/run-model-tournament.js --local --roster-size 8 --challengers 4 --max-actions 40",
    "finetune:prepare": "node scripts/prepare-finetune-data.js"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "csv-parser": "^3.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
