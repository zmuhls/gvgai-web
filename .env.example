# Ollama Cloud API key for the stated cloud model roster
OLLAMA_API_KEY=

# OpenRouter API key for provider fallback when vLLM or Ollama Cloud fails
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cadavre Exquis password-reset delivery (server only)
RESEND_API_KEY=
CADAVRE_FROM_EMAIL=
PUBLIC_BASE_URL=https://inference-arcade.com

# vLLM routes fall back to this Ollama Cloud model before OpenRouter
LEGION_FALLBACK_MODEL=gemma3:27b

# Supabase telemetry storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_TELEMETRY_TABLE=telemetry_events
TELEMETRY_ENABLED=true
TELEMETRY_BATCH_SIZE=25
TELEMETRY_FLUSH_MS=3000
TELEMETRY_FALLBACK_MODE=on-error
TELEMETRY_STORE_PROMPTS=false

# Paid inference is bounded and background inference requires an exact opt-in.
MARBLE_RUN_ENABLED=false
MARBLE_RUN_AUTOSTART=false
MARBLE_RUN_MAX_CASES=3
MARBLE_RUN_MAX_MS=300000
CADAVRE_MODEL_WARMER_ENABLED=false
CADAVRE_READY_GENERATION_ENABLED=false
MODEL_EVALS_ENABLED=false
MODEL_FINETUNE_ENABLED=false
MODEL_CONTROL_TOKEN=

# Per-run and shared remote-provider budgets
MODEL_GAME_STARTS_PER_MINUTE=3
MODEL_RUN_MAX_ACTIONS=20
MODEL_RUN_MAX_PROVIDER_CALLS=20
MODEL_RUN_MAX_MS=120000
MODEL_GUARDRAIL_HOURLY=20
MODEL_GUARDRAIL_DAILY=30
MODEL_GUARDRAIL_MONTHLY=100
MODEL_GUARDRAIL_SESSION=20
MODEL_GUARDRAIL_CADAVRE_HOURLY=5
MODEL_GUARDRAIL_CADAVRE_DAILY=10
MODEL_GUARDRAIL_CADAVRE_MONTHLY=25
